# Azure Foundry y Translator: identidad administrada del sistema, sin claves.
AZURE_AI_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/proj-default
AZURE_AI_MODEL_DEPLOYMENT=MAI-Thinking-1
AZURE_TRANSLATOR_ENDPOINT=https://example.cognitiveservices.azure.com

# Stage 4 (opcional): razonamiento profundo sobre el catálogo HS y preguntas al usuario.
# Por debajo de este valor de confianza se vuelve a razonar sobre el catálogo.
REASONING_CONFIDENCE_THRESHOLD=0.75
# Margen relativo (0.1 %) a partir del cual dos candidatos se consideran empatados.
TIE_MARGIN_THRESHOLD=0.001
# Descripciones más cortas que esto se consideran demasiado vagas.
MIN_QUERY_CHARS=25
MIN_QUERY_WORDS=4
# Máximo de preguntas de aclaración por línea.
MAX_CLARIFYING_QUESTIONS=3
