# Copia este archivo a `.env` en la raíz y rellena los valores.

# ── Proveedor LLM ──────────────────────────────────────────────────────
# 'gemini' o 'minimax'. Por defecto 'minimax' en esta versión.
LLM_PROVIDER=minimax

# Clave de Google Gemini (obligatoria sólo si LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.8-flash

# MiniMax (se accede vía SDK de Anthropic con base_url apuntando al endpoint MiniMax).
# Obligatorias sólo si LLM_PROVIDER=minimax.
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_DEFAULT_MODEL=MiniMax-M3.1-Flash

# ── Parámetros del pipeline TariffAI ───────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K_CANDIDATES=10
CONFIDENCE_THRESHOLD=0.7

# ── Backend de la webapp ───────────────────────────────────────────────
LOG_LEVEL=info
