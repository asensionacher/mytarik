# Azure Foundry y Translator: identidad administrada del sistema, sin claves.
# LLM_PROVIDER=azure usa Azure Foundry (por defecto); LLM_PROVIDER=local usa
# el endpoint opcional compatible con OpenAI indicado más abajo.
LLM_PROVIDER=azure
AZURE_AI_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/proj-default
AZURE_AI_MODEL_DEPLOYMENT=MAI-Thinking-1
AZURE_TRANSLATOR_ENDPOINT=https://example.cognitiveservices.azure.com

# Proveedor local opcional compatible con OpenAI (por ejemplo, llama-server).
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=your-local-model
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=120
